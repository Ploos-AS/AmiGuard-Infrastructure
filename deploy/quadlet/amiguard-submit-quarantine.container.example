[Unit]
Description=AmiGuard sample submission service (M3 controlled quarantine qualification)
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/amiguard-submit:local
ContainerName=amiguard-submit-m3
PublishPort=127.0.0.1:8080:8080
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
Environment=AMIGUARD_SUBMIT_ADDR=0.0.0.0:8080
Environment=AMIGUARD_UPLOAD_ENABLED=true
Environment=AMIGUARD_QUARANTINE_ROOT=/data/quarantine
Environment=AMIGUARD_MAX_UPLOAD_BYTES=16777216
Volume=%h/.local/share/amiguard/quarantine:/data/quarantine:rw
PidsLimit=64

[Service]
MemoryMax=192M
Restart=on-failure
TimeoutStopSec=15

[Install]
WantedBy=default.target
